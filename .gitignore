# Workspace repo: track only the workspace files. Every game folder is its own git repo, concepts/ is local, and
# local/ is the user's own layer (docs/local-layer.md); all are ignored here.
/*
!/.gitignore
!/.gitattributes
!/README.md
!/CLAUDE.md
!/FORK.md
!/LICENSE
!/new-game.sh
!/sync-template.sh
!/list-template-requests.sh
!/new-concept.sh
!/publish-game.sh
!/deploy-test.sh
!/studio-doctor.sh
!/studio-commit.sh
!/local.example/
!/docs/
!/concept-kit/
!/template/
!/tools/
!/licenses/

# Local state inside the template (same rules as a game repo)
/template/.claude/settings.local.json
/template/CLAUDE.local.md
/template/project.local.yaml
/template/production/session-logs/
/template/production/session-state/
/template/.claude/agent-memory/
/template/.claude/worktrees/
**/__pycache__/
.DS_Store
/tools/pixelorama-mcp/server/node_modules/
